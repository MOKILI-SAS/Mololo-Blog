---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
---

<Layout 
  title="Contact & Collaborations | Blog Mololo Studio"
  description="Prenez contact avec la rédaction et le studio de production de Blog Mololo pour proposer un projet, une session live ou un partenariat."
>
  <!-- Header -->
  <section class="border-b-2 border-black bg-black text-[#fff1d9] py-12 md:py-16 px-4 md:px-8">
    <div class="max-w-4xl mx-auto space-y-4 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#e01a31] text-white font-display text-xs font-bold uppercase tracking-widest">
        <span>Prise de Contact</span>
      </div>
      <h1 class="font-display font-black text-3xl md:text-5xl text-[#fff1d9] tracking-tight">
        Entrer en Contact avec Mololo
      </h1>
      <p class="text-sm md:text-base text-[#fff1d9]/70 max-w-xl mx-auto font-sans">
        Une proposition de reportage, une session live à enregistrer, une collaboration institutionnelle ou une question pour nos curateurs ? Écrivez-nous.
      </p>
    </div>
  </section>

  <!-- Contact Form & Info Grid -->
  <section class="max-w-6xl mx-auto px-4 md:px-8 py-14">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      <!-- Left: Form (7 cols) -->
      <div class="lg:col-span-7 border-2 border-black bg-[#fff1d9] p-6 md:p-10 shadow-xl space-y-6">
        <h2 class="font-display font-black text-xl text-black border-b border-black/15 pb-4">
          Formulaire de Contact
        </h2>

        <form id="contact-form" class="space-y-4 font-sans text-sm">
          <div>
            <label class="block text-xs font-bold uppercase text-black mb-1">
              Nature de la demande *
            </label>
            <select 
              required
              class="w-full px-3.5 py-3 bg-white text-black border-2 border-black focus:outline-none focus:ring-2 focus:ring-[#e01a31]"
            >
              <option value="session">Proposer une Session Live (Mololo Session)</option>
              <option value="reportage">Proposition d'article / Reportage (Mololo News / Radar)</option>
              <option value="partenariat">Partenariat Studio & Coproduction</option>
              <option value="club">Événement & Mololo Club</option>
              <option value="presse">Presse & Relations Médias</option>
              <option value="autre">Autre demande</option>
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold uppercase text-black mb-1">
                Nom complet *
              </label>
              <input 
                type="text" 
                required 
                placeholder="Votre nom"
                class="w-full px-3.5 py-3 bg-white text-black border-2 border-black focus:outline-none focus:ring-2 focus:ring-[#e01a31]"
              />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase text-black mb-1">
                Email professionnel *
              </label>
              <input 
                type="email" 
                required 
                placeholder="nom@domaine.com"
                class="w-full px-3.5 py-3 bg-white text-black border-2 border-black focus:outline-none focus:ring-2 focus:ring-[#e01a31]"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold uppercase text-black mb-1">
                Artiste, Collectif ou Organisation
              </label>
              <input 
                type="text" 
                placeholder="Ex: Likolo Collective"
                class="w-full px-3.5 py-3 bg-white text-black border-2 border-black focus:outline-none focus:ring-2 focus:ring-[#e01a31]"
              />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase text-black mb-1">
                Ville / Pays *
              </label>
              <input 
                type="text" 
                required 
                placeholder="Ex: Kinshasa, RDC"
                class="w-full px-3.5 py-3 bg-white text-black border-2 border-black focus:outline-none focus:ring-2 focus:ring-[#e01a31]"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase text-black mb-1">
              Lien d'écoute ou portfolio (SoundCloud, Spotify, YouTube, Drive)
            </label>
            <input 
              type="url" 
              placeholder="https://..."
              class="w-full px-3.5 py-3 bg-white text-black border-2 border-black focus:outline-none focus:ring-2 focus:ring-[#e01a31]"
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase text-black mb-1">
              Message détaillé *
            </label>
            <textarea 
              required 
              rows="5"
              placeholder="Présentez votre démarche, l'histoire de votre projet et vos attentes..."
              class="w-full px-3.5 py-3 bg-white text-black border-2 border-black focus:outline-none focus:ring-2 focus:ring-[#e01a31]"
            ></textarea>
          </div>

          <button 
            type="submit"
            class="w-full py-4 bg-[#e01a31] text-white font-display text-xs font-black uppercase tracking-widest hover:bg-black transition-colors"
          >
            Envoyer ma proposition
          </button>
        </form>

        <div id="contact-success" class="hidden p-6 bg-black text-[#fff1d9] border-2 border-[#e01a31] text-center space-y-2">
          <span class="font-display font-bold text-base text-[#e01a31] block">
            ✓ Message Reçu avec Succès !
          </span>
          <p class="text-xs text-white/80">
            Merci pour votre intérêt. Notre comité éditorial et l'équipe de production étudient votre proposition et vous répondront dans les plus brefs délais.
          </p>
        </div>
      </div>

      <!-- Right: Direct details & Hubs (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="border-2 border-black bg-black text-[#fff1d9] p-6 md:p-8 space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-white/20">
            <span class="font-display font-bold text-xs uppercase text-[#e01a31] tracking-wider">
              L'Équipe Éditoriale
            </span>
            <Logo variant="white" size="sm" />
          </div>

          <p class="text-xs text-white/80 leading-relaxed font-sans">
            Pour les envois directs de communiqués de presse, fichiers audios WAV ou accréditations festivals :
          </p>

          <div class="space-y-3 pt-2 text-xs font-mono">
            <div>
              <span class="text-white/50 block text-[10px] uppercase">Rédaction & Propositions</span>
              <a href="mailto:redaction@mololo.media" class="font-bold text-white hover:text-[#e01a31] transition-colors">
                redaction@mololo.media
              </a>
            </div>
            <div>
              <span class="text-white/50 block text-[10px] uppercase">Partenariats & Studio</span>
              <a href="mailto:studio@mololo.media" class="font-bold text-white hover:text-[#e01a31] transition-colors">
                studio@mololo.media
              </a>
            </div>
          </div>
        </div>

        <!-- City Hubs -->
        <div class="border-2 border-black bg-[#fff7ea] p-6 space-y-4">
          <h3 class="font-display font-bold text-xs uppercase tracking-wider text-black">
            Bureaux & Correspondances
          </h3>
          <div class="grid grid-cols-2 gap-4 text-xs font-sans text-black/80">
            <div class="border-l-2 border-[#e01a31] pl-2.5">
              <span class="font-bold block text-black">Kinshasa</span>
              <span class="text-[11px] text-black/60">Gombe & Bandalungwa</span>
            </div>
            <div class="border-l-2 border-[#e01a31] pl-2.5">
              <span class="font-bold block text-black">Dakar</span>
              <span class="text-[11px] text-black/60">Grand Yoff & Plateau</span>
            </div>
            <div class="border-l-2 border-[#e01a31] pl-2.5">
              <span class="font-bold block text-black">Lagos</span>
              <span class="text-[11px] text-black/60">Ikeja & Victoria Island</span>
            </div>
            <div class="border-l-2 border-[#e01a31] pl-2.5">
              <span class="font-bold block text-black">Paris</span>
              <span class="text-[11px] text-black/60">Antenne Europe</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form');
  const success = document.getElementById('contact-success');
  if (form && success) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.classList.add('hidden');
      success.classList.remove('hidden');
    });
  }
</script>
