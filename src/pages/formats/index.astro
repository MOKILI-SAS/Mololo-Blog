---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allFormats = await getCollection('formats');
const sortedFormats = allFormats.sort((a, b) => a.data.order - b.data.order);
const allArticles = await getCollection('articles');
---

<Layout 
  title="Les 8 Formats Officiels | Studio Média Blog Mololo"
  description="Découvrez l'écosystème de formats médias de Blog Mololo : Sessions, Club, Radar, News, +, Episode, Playlist et Original."
>
  <!-- Header -->
  <section class="border-b-2 border-black bg-black text-[#fff1d9] py-12 md:py-16 px-4 md:px-8">
    <div class="max-w-7xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#e01a31] text-white font-display text-xs font-bold uppercase tracking-widest">
        <span>L'Écosystème Média</span>
      </div>
      <h1 class="font-display font-black text-3xl md:text-5xl text-[#fff1d9] tracking-tight">
        Les 8 Formats de Blog Mololo
      </h1>
      <p class="text-sm md:text-base text-[#fff1d9]/70 max-w-2xl font-sans">
        Une architecture éditoriale pensée pour capturer la diversité de la création contemporaine, de la ferveur live des studios aux explorations documentaires de long cours.
      </p>
    </div>
  </section>

  <!-- Formats Grid -->
  <section class="max-w-7xl mx-auto px-4 md:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {sortedFormats.map((f) => {
        const count = allArticles.filter((a) => a.data.format.toLowerCase() === f.data.name.toLowerCase()).length;
        const isRed = f.data.badgeColor === '#e01a31';
        return (
          <div class="border-2 border-black bg-[#fff1d9] p-6 flex flex-col justify-between hover:translate-y-[-4px] transition-transform shadow-lg group">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class={`font-display text-[10px] font-extrabold uppercase px-2.5 py-1 ${isRed ? 'bg-[#e01a31] text-white' : 'bg-black text-[#fff1d9]'}`}>
                  {f.data.frequency}
                </span>
                <span class="font-mono text-xs font-bold text-black/50">
                  {count} article{count > 1 ? 's' : ''}
                </span>
              </div>

              <h2 class="font-display font-black text-xl text-black group-hover:text-[#e01a31] transition-colors leading-tight">
                {f.data.name}
              </h2>

              <p class="text-xs font-semibold text-black/90 uppercase tracking-wide">
                {f.data.tagline}
              </p>

              <p class="text-xs text-black/70 leading-relaxed font-sans">
                {f.data.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-black/15">
              <a 
                href={`/formats/${f.data.slug}/`}
                class="inline-flex items-center justify-between w-full text-xs font-display font-bold uppercase tracking-wider text-black group-hover:text-[#e01a31] transition-colors"
              >
                <span>Explorer le format</span>
                <span>→</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Layout>
