---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allFormats = await getCollection('formats');
  return allFormats.map((format) => ({
    params: { format: format.data.slug },
    props: { format },
  }));
}

const { format } = Astro.props;
const { Content } = await render(format);

const allArticles = await getCollection('articles');
const formatArticles = allArticles.filter(
  (a) => a.data.format.toLowerCase() === format.data.name.toLowerCase()
);
---

<Layout 
  title={`${format.data.name} | Formats Mololo`}
  description={format.data.description}
>
  <!-- Format Hero -->
  <section class="border-b-2 border-black bg-black text-[#fff1d9] py-12 md:py-16 px-4 md:px-8">
    <div class="max-w-7xl mx-auto space-y-4">
      <div class="flex items-center gap-3">
        <a href="/formats/" class="text-xs font-mono uppercase text-[#fff1d9]/60 hover:text-white">
          ← Tous les Formats
        </a>
        <span class="text-white/30">•</span>
        <span class="text-xs uppercase font-mono px-2 py-0.5 bg-[#e01a31] text-white">
          {format.data.frequency}
        </span>
      </div>

      <h1 class="font-display font-black text-3xl md:text-5xl lg:text-6xl text-white tracking-tight">
        {format.data.name}
      </h1>

      <p class="font-display text-base md:text-xl text-[#e01a31] font-bold">
        {format.data.tagline}
      </p>

      <p class="text-sm md:text-base text-[#fff1d9]/80 max-w-3xl leading-relaxed font-sans">
        {format.data.description}
      </p>
    </div>
  </section>

  <!-- Editorial Manifesto of the Format -->
  <section class="border-b-2 border-black bg-[#fff7ea] py-8 px-4 md:px-8">
    <div class="max-w-4xl mx-auto text-sm md:text-base text-black/85 leading-relaxed font-sans prose prose-neutral">
      <Content />
    </div>
  </section>

  <!-- Articles List in this format -->
  <section class="max-w-7xl mx-auto bg-[#fff1d9] py-10 px-4 md:px-8">
    <div class="flex items-center justify-between pb-6 border-b border-black/20 mb-8">
      <h2 class="font-display font-extrabold text-lg uppercase tracking-wider text-black">
        Publications dans ce format ({formatArticles.length})
      </h2>
    </div>

    {formatArticles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {formatArticles.map((article) => (
          <div class="border-2 border-black bg-[#fff1d9]">
            <ArticleCard article={article} />
          </div>
        ))}
      </div>
    ) : (
      <div class="p-12 text-center border-2 border-dashed border-black/30">
        <p class="font-display text-sm uppercase text-black/60 font-bold mb-2">
          De nouvelles sessions et épisodes sont actuellement en cours de montage.
        </p>
        <p class="text-xs text-black/50">
          Abonnez-vous à la newsletter Mololo pour être prévenu dès la parution.
        </p>
      </div>
    )}
  </section>
</Layout>
