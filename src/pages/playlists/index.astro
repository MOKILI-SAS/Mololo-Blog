---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const allPlaylists = await getCollection('playlists');
---

<Layout 
  title="Playlists & Curations Musicales | Blog Mololo"
  description="Les sélections musicales hebdomadaires de Blog Mololo : sélections pointues, raretés et classiques de la scène africaine et de la diaspora."
>
  <!-- Header -->
  <section class="border-b-2 border-black bg-black text-[#fff1d9] py-12 md:py-16 px-4 md:px-8">
    <div class="max-w-7xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#e01a31] text-white font-display text-xs font-bold uppercase tracking-widest">
        <span>Curations & Soundtracks</span>
      </div>
      <h1 class="font-display font-black text-3xl md:text-5xl text-[#fff1d9] tracking-tight">
        Mololo Playlists
      </h1>
      <p class="text-sm md:text-base text-[#fff1d9]/70 max-w-2xl font-sans">
        Écoutez les vibrations sélectionnées par nos curateurs entre Kinshasa, Lagos, Abidjan et Johannesburg.
      </p>
    </div>
  </section>

  <!-- Playlists Grid -->
  <section class="max-w-7xl mx-auto px-4 md:px-8 py-12">
    <div class="space-y-12">
      {allPlaylists.map(async (playlist) => {
        const { Content } = await render(playlist);
        return (
          <div class="border-2 border-black bg-[#fff1d9] grid grid-cols-1 lg:grid-cols-12 overflow-hidden shadow-xl">
            <!-- Left: Artwork -->
            <div class="lg:col-span-5 relative min-h-[320px] lg:min-h-full border-b lg:border-b-0 lg:border-r-2 border-black">
              <img 
                src={playlist.data.coverImage} 
                alt={playlist.data.title}
                class="w-full h-full object-cover"
              />
              <span class="absolute top-4 left-4 bg-[#e01a31] text-white font-display text-xs font-bold px-3 py-1 uppercase shadow">
                {playlist.data.city}
              </span>
            </div>

            <!-- Right: Details & Player -->
            <div class="lg:col-span-7 p-6 md:p-10 flex flex-col justify-between space-y-6">
              <div class="space-y-4">
                <div class="flex items-center gap-3 text-xs font-mono text-black/60">
                  <span>{playlist.data.tracksCount} Titres</span>
                  <span>•</span>
                  <span>{playlist.data.duration}</span>
                  <span>•</span>
                  <span class="font-bold text-[#e01a31]">Curé par {playlist.data.curator}</span>
                </div>

                <h2 class="font-display font-black text-2xl md:text-3xl text-black">
                  {playlist.data.title}
                </h2>

                <p class="text-sm text-black/80 font-sans leading-relaxed">
                  {playlist.data.description}
                </p>

                <div class="prose prose-sm text-black/75 pt-2">
                  <Content />
                </div>
              </div>

              <!-- Featured Audio Track / Capsule -->
              {playlist.data.featuredTrack && (
                <div class="p-4 bg-black text-[#fff1d9] border border-black flex flex-col sm:flex-row items-center justify-between gap-4">
                  <div class="flex items-center gap-3">
                    <span class="w-3 h-3 rounded-full bg-[#e01a31] animate-ping"></span>
                    <div>
                      <span class="text-[10px] font-display font-bold uppercase text-[#e01a31] block">
                        Extrait Recommandé
                      </span>
                      <span class="text-xs font-bold font-display text-white">
                        {playlist.data.featuredTrack.title} — {playlist.data.featuredTrack.artist}
                      </span>
                    </div>
                  </div>
                  <audio controls src={playlist.data.featuredTrack.previewUrl} class="h-8 max-w-[220px]"></audio>
                </div>
              )}

              <!-- Streaming Outbound Links -->
              <div class="pt-4 border-t border-black/15 flex flex-wrap items-center gap-3">
                {playlist.data.spotifyUrl && (
                  <a 
                    href={playlist.data.spotifyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-4 py-2.5 bg-[#1DB954] text-black font-display text-xs font-bold uppercase tracking-wider hover:brightness-110 transition-all inline-flex items-center gap-2"
                  >
                    <span>Écouter sur Spotify</span>
                  </a>
                )}
                {playlist.data.appleMusicUrl && (
                  <a 
                    href={playlist.data.appleMusicUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-4 py-2.5 bg-black text-white font-display text-xs font-bold uppercase tracking-wider hover:bg-[#e01a31] transition-all inline-flex items-center gap-2"
                  >
                    <span>Apple Music</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Layout>
