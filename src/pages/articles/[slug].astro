---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

// Related articles
const allArticles = await getCollection('articles');
const relatedArticles = allArticles
  .filter((a) => a.id !== article.id)
  .slice(0, 3);

const articleUrl = `https://mololo.media/articles/${article.id}/`;
---

<Layout 
  title={article.data.title}
  description={article.data.excerpt}
  image={article.data.coverImage}
  type="article"
  publishDate={article.data.publishDate}
  author={article.data.author}
>
  <article class="bg-white min-h-screen">
    
    <!-- Top Article Header (Clean Editorial PAM format) -->
    <header class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 md:pt-14 pb-8 space-y-6">
      
      <!-- Back Navigation & Format Tag -->
      <div class="flex items-center justify-between border-b border-black/10 pb-4">
        <a 
          href="/articles/" 
          class="inline-flex items-center gap-1.5 text-xs font-display font-bold uppercase text-black/60 hover:text-[#e01a31] transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          <span>Retour aux articles</span>
        </a>

        <div class="flex items-center gap-2">
          <span class="px-2.5 py-1 bg-[#e01a31] text-white font-display text-[10px] font-black uppercase tracking-wider">
            {article.data.format}
          </span>
          <span class="text-xs text-black/40 font-mono uppercase">
            {article.data.city}
          </span>
        </div>
      </div>

      <!-- Main Headline -->
      <h1 class="font-display font-black text-2xl sm:text-4xl md:text-5xl text-black leading-[1.12] tracking-tight">
        {article.data.title}
      </h1>

      {article.data.subtitle && (
        <p class="text-base sm:text-lg font-medium text-black/75 leading-relaxed font-sans italic border-l-2 border-[#e01a31] pl-3.5">
          {article.data.subtitle}
        </p>
      )}

      <!-- Metadata & Author Line -->
      <div class="pt-2 flex flex-wrap items-center justify-between gap-4 text-xs text-black/60 font-sans border-b border-black/10 pb-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-[#e01a31] text-white flex items-center justify-center font-display font-bold text-xs uppercase">
            {article.data.author.substring(0, 2)}
          </div>
          <div>
            <span class="font-bold uppercase text-black block">Par {article.data.author}</span>
            <span class="text-[11px] text-black/50">Publié le {article.data.publishDate} • {article.data.readTime} de lecture</span>
          </div>
        </div>

        <!-- Social Share Bar (Top) -->
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-display font-bold uppercase text-black/40 mr-1 hidden sm:inline">Partager :</span>
          
          <!-- WhatsApp -->
          <a 
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.data.title + ' ' + articleUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-full bg-[#25D366] text-white hover:opacity-85 transition-opacity"
            title="Partager sur WhatsApp"
            aria-label="Partager sur WhatsApp"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          </a>

          <!-- Twitter / X -->
          <a 
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.data.title)}&url=${encodeURIComponent(articleUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-full bg-black text-white hover:bg-[#e01a31] transition-colors"
            title="Partager sur X (Twitter)"
            aria-label="Partager sur X"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>

          <!-- Facebook -->
          <a 
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(articleUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-full bg-[#1877F2] text-white hover:opacity-85 transition-opacity"
            title="Partager sur Facebook"
            aria-label="Partager sur Facebook"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
          </a>

          <!-- Copy Link Button -->
          <button 
            id="copy-link-btn"
            class="p-2 rounded-full bg-black/10 hover:bg-[#e01a31] hover:text-white transition-colors cursor-pointer text-black"
            title="Copier le lien"
            aria-label="Copier le lien de l'article"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Full-Width Cover Image (Framed, cinematic) -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
      <div class="relative overflow-hidden aspect-16/9 bg-black shadow-lg">
        <img 
          src={article.data.coverImage} 
          alt={article.data.title}
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    <!-- Complete Reading Body Container -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 space-y-10">
      
      <!-- Full Markdown Article Content -->
      <div class="prose prose-lg prose-neutral max-w-none text-black/90 font-sans leading-relaxed prose-headings:font-display prose-headings:font-bold prose-headings:tracking-tight prose-a:text-[#e01a31] prose-blockquote:border-l-4 prose-blockquote:border-[#e01a31] prose-blockquote:bg-[#fff1d9] prose-blockquote:py-3 prose-blockquote:px-5 prose-blockquote:italic">
        <Content />
      </div>

      <!-- Share Box at the bottom of the article -->
      <div class="p-6 bg-[#fff1d9] border-2 border-black flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="font-display font-black text-sm uppercase tracking-wide text-black block">
            Vous avez apprécié cette lecture ?
          </span>
          <span class="text-xs text-black/70">
            Faites rayonner la culture en partageant cet article autour de vous.
          </span>
        </div>

        <div class="flex items-center gap-2">
          <a 
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.data.title + ' ' + articleUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 bg-[#25D366] text-white font-display text-xs font-bold uppercase rounded-none hover:opacity-90 transition-opacity flex items-center gap-1.5"
          >
            WhatsApp
          </a>
          <a 
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.data.title)}&url=${encodeURIComponent(articleUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 bg-black text-white font-display text-xs font-bold uppercase rounded-none hover:bg-[#e01a31] transition-colors"
          >
            X (Twitter)
          </a>
          <button 
            id="copy-link-btn-bottom"
            class="px-4 py-2 border border-black text-black hover:bg-black hover:text-white font-display text-xs font-bold uppercase transition-colors cursor-pointer"
          >
            Copier le lien
          </button>
        </div>
      </div>

      <!-- Toast Feedback notification for copy link -->
      <div 
        id="toast-copy" 
        class="fixed bottom-20 right-6 z-50 bg-black text-white px-5 py-3 shadow-2xl border-l-4 border-[#e01a31] font-sans text-xs font-bold uppercase tracking-wider hidden transition-all"
      >
        ✓ Lien copié dans votre presse-papier !
      </div>
    </div>

    <!-- Related Articles Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 border-t-2 border-black bg-white">
      <div class="mb-8 border-b-2 border-black/10 pb-3 flex items-center justify-between">
        <h2 class="font-display font-black text-sm md:text-base uppercase tracking-wider text-black">
          À lire également
        </h2>
        <a href="/articles/" class="text-xs font-bold uppercase text-black/60 hover:text-[#e01a31]">
          Voir tout le catalogue →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {relatedArticles.map((rel) => (
          <ArticleCard article={rel} />
        ))}
      </div>
    </section>
  </article>
</Layout>

<script>
  function setupCopyButton(btnId: string) {
    const btn = document.getElementById(btnId);
    const toast = document.getElementById('toast-copy');
    if (btn && toast) {
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href).then(() => {
          toast.classList.remove('hidden');
          setTimeout(() => {
            toast.classList.add('hidden');
          }, 3000);
        });
      });
    }
  }

  setupCopyButton('copy-link-btn');
  setupCopyButton('copy-link-btn-bottom');
</script>
