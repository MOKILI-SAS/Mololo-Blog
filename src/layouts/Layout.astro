---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import PlaylistModal from '../components/PlaylistModal.astro';
import { SITE_CONFIG, formatTitle, generateOrganizationSchema } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: string;
  author?: string;
  hideTicker?: boolean;
}

const {
  title = SITE_CONFIG.tagline,
  description = SITE_CONFIG.description,
  image = SITE_CONFIG.defaultOgImage,
  type = 'website',
  publishDate,
  author = SITE_CONFIG.author,
} = Astro.props;

const pageTitle = formatTitle(title);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://mololo.media').href;
const orgSchema = generateOrganizationSchema();

// Is home page with full-bleed hero?
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content={SITE_CONFIG.themeColor} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={SITE_CONFIG.twitterHandle} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {publishDate && <meta property="article:published_time" content={publishDate} />}
    {author && <meta property="article:author" content={author} />}

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body class="bg-white text-black min-h-screen flex flex-col font-sans selection:bg-[#e01a31] selection:text-white">
    <!-- Header with dynamic transparency on Home Hero -->
    <Header isHomeHero={isHome} />

    <!-- Main Content Slot -->
    <main class={`flex-1 ${!isHome ? 'pt-13 md:pt-14' : ''}`}>
      <slot />
    </main>

    <!-- Footer (Exact PAM reference in Red Mololo edition) -->
    <Footer />

    <!-- Audio Player Persistant & Lecteur Spotify -->
    <AudioPlayer />

    <!-- Modal Officiel de Sélection de Plateformes Playlist (Spotify / Apple Music) -->
    <PlaylistModal />
  </body>
</html>
