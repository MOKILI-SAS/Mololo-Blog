---
import Logo from './Logo.astro';
---

<!-- PAM Footer (Red Edition - Diminution taille logo & alignement exact sur Capture 5) -->
<footer class="w-full bg-[#e01a31] text-white pt-14 pb-12 px-4 sm:px-6 lg:px-8 border-t-2 border-black">
  <div class="max-w-6xl mx-auto space-y-10">
    
    <!-- Exact Row Layout from Capture 5: Logo Mololo réduit (gauche), Liens (centre), Réseaux (droite) -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-white/20">
      
      <!-- Left: Logo Mololo avec taille diminuée (compacte & élégante) -->
      <div class="flex items-center">
        <a href="/" aria-label="Accueil Blog Mololo" class="inline-block hover:opacity-85 transition-opacity">
          <Logo variant="white" size="md" />
        </a>
      </div>

      <!-- Center: Clean Inline Links (Exactement comme Capture 5 PAM) -->
      <nav class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-xs md:text-sm font-sans font-medium text-white">
        <a href="/ecosysteme/" class="hover:underline transition-all font-bold">
          Écosystème
        </a>
        <span class="text-white/40">|</span>
        <a href="/a-propos/" class="hover:underline transition-all">
          À propos
        </a>
        <span class="text-white/40">|</span>
        <a href="/confidentialite/" class="hover:underline transition-all">
          Confidentialité
        </a>
        <span class="text-white/40">|</span>
        <a href="/mentions-legales/" class="hover:underline transition-all">
          Mentions Légales
        </a>
        <span class="text-white/40">|</span>
        <a href="/#pam-newsletter-form" class="hover:underline transition-all">
          Newsletter
        </a>
      </nav>

      <!-- Right: Social Media Icons (Facebook, Instagram, Twitter/X, YouTube, TikTok) -->
      <div class="flex items-center gap-4 text-white">
        <!-- Facebook -->
        <a href="https://www.facebook.com/oyomololo" target="_blank" rel="noopener noreferrer" class="hover:text-black transition-colors" aria-label="Facebook">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
          </svg>
        </a>
        <!-- Instagram -->
        <a href="https://www.instagram.com/oyomololo" target="_blank" rel="noopener noreferrer" class="hover:text-black transition-colors" aria-label="Instagram">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <!-- Twitter / X -->
        <a href="https://x.com/oyomololo" target="_blank" rel="noopener noreferrer" class="hover:text-black transition-colors" aria-label="X Twitter">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <!-- YouTube -->
        <a href="https://www.youtube.com/@oyomololo" target="_blank" rel="noopener noreferrer" class="hover:text-black transition-colors" aria-label="YouTube">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </a>
        <!-- TikTok -->
        <a href="https://www.tiktok.com/@oyomololo" target="_blank" rel="noopener noreferrer" class="hover:text-black transition-colors" aria-label="TikTok">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.29 0 .58.04.86.11V9.4a6.33 6.33 0 0 0-.86-.06A6.34 6.34 0 0 0 3 15.68a6.34 6.34 0 0 0 10.82 4.48c.37-.37.67-.8.88-1.28V10.23a8.27 8.27 0 0 0 4.89 1.6V8.39a4.84 4.84 0 0 1-.0-.0v-1.7z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Bottom Exact Copyright Line & Mention Obligatoire MOKILI (Style PAM) -->
    <div class="text-center space-y-2 text-[11px] text-white/90">
      <p class="font-sans">
        © 2026 <strong>Blog Mololo Magazine</strong> — 
        <a 
          href="https://mokili.io" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="font-display font-extrabold text-white underline hover:text-black transition-colors ml-1"
          title="Propulsé par MOKILI"
        >
          Propulsé par MOKILI
        </a>
      </p>

      <p class="text-[10px] text-white/70 max-w-xl mx-auto leading-relaxed pt-1">
        Tous droits réservés. En utilisant ce site vous acceptez sa politique de confidentialité. Le contenu de ce site ne peut pas être reproduit ou distribué sans l'autorisation écrite préalable de Mololo Studio.
      </p>
    </div>
  </div>
</footer>
