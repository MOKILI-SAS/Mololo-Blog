---
interface Props {
  article: {
    id: string;
    data: {
      title: string;
      subtitle?: string;
      format: string;
      category: string;
      author: string;
      city: string;
      publishDate: string;
      readTime: string;
      coverImage: string;
      excerpt: string;
      audioPreviewUrl?: string;
    };
  };
  layout?: 'standard' | 'horizontal' | 'compact';
  class?: string;
}

const { article, layout = 'standard', class: className = '' } = Astro.props;
const articleHref = `/articles/${article.id}/`;
---

{layout === 'horizontal' ? (
  <article class={`bg-white border-b border-black/10 grid grid-cols-1 md:grid-cols-12 group p-4 md:p-6 gap-6 hover:bg-black/5 transition-colors ${className}`}>
    <div class="md:col-span-5 relative aspect-16/10 overflow-hidden bg-black/5">
      <a href={articleHref} class="block w-full h-full">
        <img 
          src={article.data.coverImage} 
          alt={article.data.title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      </a>
      <span class="absolute top-2 left-2 bg-[#e01a31] text-white font-display text-[10px] font-extrabold uppercase px-2 py-1 pointer-events-none">
        {article.data.format}
      </span>
    </div>
    <div class="md:col-span-7 flex flex-col justify-between">
      <div>
        <div class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-wider text-[#e01a31] mb-2">
          <span>{article.data.category}</span>
          <span>•</span>
          <span class="text-black/60">{article.data.city}</span>
        </div>
        <h3 class="font-display font-bold text-lg md:text-xl leading-tight text-black group-hover:text-[#e01a31] transition-colors mb-2">
          <a href={articleHref}>
            {article.data.title}
          </a>
        </h3>
        <p class="text-xs md:text-sm text-black/75 line-clamp-2">
          {article.data.excerpt}
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-black/10 flex items-center justify-between text-xs text-black/60">
        <span class="font-bold uppercase text-black">Par {article.data.author}</span>
        <span>{article.data.readTime}</span>
      </div>
    </div>
  </article>
) : layout === 'compact' ? (
  <article class={`bg-white border-b border-black/10 p-4 group hover:bg-black/5 transition-colors ${className}`}>
    <div class="flex items-center gap-2 text-[10px] font-bold uppercase text-[#e01a31] mb-1.5">
      <span>{article.data.format}</span>
      <span>•</span>
      <span class="text-black/50">{article.data.city}</span>
    </div>
    <h4 class="font-display font-bold text-sm leading-snug text-black group-hover:text-[#e01a31] transition-colors mb-2">
      <a href={articleHref}>
        {article.data.title}
      </a>
    </h4>
    <div class="text-[11px] text-black/50 flex justify-between">
      <span>Par {article.data.author}</span>
      <span>{article.data.readTime}</span>
    </div>
  </article>
) : (
  <article class={`bg-white border-b md:border-r border-black/10 flex flex-col justify-between group p-5 md:p-6 hover:bg-black/5 transition-colors ${className}`}>
    <div>
      <div class="relative aspect-16/10 overflow-hidden bg-black/5 mb-4">
        <a href={articleHref} class="block w-full h-full">
          <img 
            src={article.data.coverImage} 
            alt={article.data.title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </a>
        <div class="absolute top-2 left-2 flex gap-1 pointer-events-none">
          <span class="bg-[#e01a31] text-white font-display text-[10px] font-extrabold uppercase px-2 py-0.5 shadow-sm">
            {article.data.format}
          </span>
        </div>
        {article.data.audioPreviewUrl && (
          <span class="absolute bottom-2 right-2 bg-black/80 text-white text-[10px] font-display font-bold px-2 py-0.5 flex items-center gap-1 pointer-events-none">
            <span class="w-1.5 h-1.5 rounded-full bg-[#e01a31] animate-ping"></span>
            Audio
          </span>
        )}
      </div>

      <div class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-wider text-[#e01a31] mb-2">
        <span>{article.data.category}</span>
        <span class="text-black/30">•</span>
        <span class="text-black/60">{article.data.city}</span>
      </div>

      <h3 class="font-display font-bold text-lg md:text-xl leading-tight text-black group-hover:text-[#e01a31] transition-colors mb-2.5">
        <a href={articleHref}>
          {article.data.title}
        </a>
      </h3>

      <p class="text-xs md:text-sm text-black/75 line-clamp-3 leading-relaxed">
        {article.data.excerpt}
      </p>
    </div>

    <div class="mt-6 pt-4 border-t border-black/15 flex items-center justify-between text-xs text-black/60">
      <span class="font-bold uppercase text-black truncate max-w-[140px]">Par {article.data.author}</span>
      <span class="shrink-0">{article.data.readTime}</span>
    </div>
  </article>
)}
